// The rest of the faces, the cat faces, the monkeys and the gesturing people.
// Original Remedy Emoji art.
category smileys

part f3_squint
  stroke $ink 3
  mirror line 16.5 22 26 26.5 17 31

part f3_kiss
  nofill
  stroke $ink 2.6
  curve 30 39.5 35.5 41.5 31 44.5 35.5 47.5 30 50

part f3_cold
  fill lin #6fb0f6dd #6fb0f600 0 5 0 30
  circle 32 32 26.4

part f3_sweat
  use drop 19 -15 0.26

part f3_wail
  fill $mouth
  path M 19 50 Q 20 38 32 38 Q 44 38 45 50 Q 38 45.5 32 45.5 Q 26 45.5 19 50 Z

emoji smiley U+1F603 | happy smile joy glad
  use face
  fill $ink
  mirror ellipse 22 24.5 3.6 5.6
  fill $mouth
  path M 16.5 35 Q 32 39 47.5 35 Q 47 53 32 53 Q 17 53 16.5 35 Z
  fill $tongue
  path M 22 49 Q 32 42.5 42 49 Q 37 53 32 53 Q 27 53 22 49 Z

emoji confounded U+1F616 | frustrated ugh quiver
  use face
  use f3_squint
  nofill
  stroke $ink 3
  line 20 46 24 42 28 46 32 42 36 46 40 42 44 46

emoji kissing U+1F617 | kiss smooch love
  use face
  use eyes
  use f3_kiss

emoji kissing_smiling_eyes U+1F619 | kiss smooch whistle
  use face
  use eyes_happy
  use f3_kiss

emoji kissing_closed_eyes U+1F61A | kiss smooch blush love
  use face
  use eyes_closed
  use blush
  use f3_kiss

emoji squinting_tongue U+1F61D | bleh playful tease taste
  use face
  use f3_squint
  fill $mouth
  path M 19 37 Q 32 41 45 37 Q 44 46 32 46 Q 20 46 19 37 Z
  use tongue_out

emoji disappointed U+1F61E | sad let down upset
  use face
  stroke $ink 3
  mirror arc 22 27 4.8 3.6 25 155
  use frown

emoji persevering U+1F623 | struggle effort endure ugh
  use face
  use f3_squint
  stroke $ink 2.6
  mirror line 14.5 17 25 13.5
  stroke $ink 3
  arc 32 50 9 6 205 335

emoji sad_relieved U+1F625 | phew whew sweat disappointed
  use face
  use eyes
  use brows_sad
  stroke $ink 3
  arc 32 49 8 5.5 205 335
  use f3_sweat

emoji frowning_open_mouth U+1F626 | oh no aw dismay
  use face
  use eyes
  fill $mouth
  path M 21 50 Q 22 40 32 40 Q 42 40 43 50 Z

emoji anguished U+1F627 | distress pain shock
  use face
  use eyes
  use brows_sad
  fill $mouth
  path M 21 51 Q 22 40 32 40 Q 42 40 43 51 Z

emoji fearful U+1F628 | scared afraid fear shock
  use face
  use f3_cold
  use eyes_wide
  stroke $ink 2.6
  mirror line 14.5 15.5 25 12
  fill $mouth
  nostroke
  path M 22 51 Q 23 42 32 42 Q 41 42 42 51 Z

emoji weary U+1F629 | tired exhausted ugh done
  use face
  stroke $ink 3
  mirror line 15.5 28.5 26.5 24.5
  mirror arc 21.5 27.5 5 4.5 30 140
  use f3_wail

emoji sleepy U+1F62A | tired drowsy snot nap
  use face
  use eyes_closed
  stroke $ink 3
  arc 32 46 6 4 205 335
  fill lin #d5efff $tear 0 34 0 52
  stroke $teard 1.4
  path M 36.5 36 Q 48 41 46.5 48.5 Q 43 53 39 49 Q 37 43 36.5 36 Z

emoji tired_face U+1F62B | exhausted fed up whine
  use face
  use f3_squint
  use f3_wail

emoji hushed U+1F62F | quiet surprised oh silent
  use face
  use eyes
  stroke $ink 2.6
  mirror line 15 15.5 25.5 14
  fill $mouth
  nostroke
  ellipse 32 45 4.2 5

emoji cold_sweat U+1F630 | anxious nervous worried stress
  use face
  use f3_cold
  use eyes
  use brows_sad
  fill $mouth
  path M 22 51 Q 23 42 32 42 Q 41 42 42 51 Z
  use f3_sweat

// The cat faces.
part f3_cat
  fill rad #ffd27a #f5a12e 24 20 46
  stroke #b0661a 2.2
  mirror poly 9 28 7 5 27 14
  fill #ffb0b0
  nostroke
  mirror poly 12 20 11 10.5 20 15
  fill rad #ffd27a #f5a12e 24 20 46
  stroke #b0661a 2.2
  ellipse 32 35 25 22
  fill #ff8fa3
  nostroke
  poly 29 37.5 35 37.5 32 41
  stroke #b0661a 1.5
  mirror line 13 40 4 38
  mirror line 13 44 5 47

part f3_cat_smile
  nofill
  stroke $ink 2
  curve 25 44.5 28.5 47 32 43 35.5 47 39 44.5

part f3_cat_open
  fill $mouth
  stroke $ink 1.6
  path M 24.5 43.5 Q 32 46 39.5 43.5 Q 39 53.5 32 53.5 Q 25 53.5 24.5 43.5 Z
  fill $tongue
  nostroke
  path M 27.5 51 Q 32 47 36.5 51 Q 34 53 32 53 Q 30 53 27.5 51 Z

emoji cat_grin U+1F638 | kitty happy smile grin
  use f3_cat
  use eyes_happy 0 3
  use f3_cat_open
  fill $white
  path M 26 44.6 Q 32 46.6 38 44.6 L 37.6 47 Q 32 48.6 26.4 47 Z

emoji cat_joy U+1F639 | kitty laugh tears lol
  use f3_cat
  use eyes_happy 0 3
  use f3_cat_open
  use tears 0 4

emoji cat_smile U+1F63A | kitty happy open mouth
  use f3_cat
  use eyes 0 3
  use f3_cat_open

emoji cat_heart_eyes U+1F63B | kitty love adore crush
  use f3_cat
  mirror use heart -10.5 -3.5 0.21
  use f3_cat_smile

emoji cat_smirk U+1F63C | kitty wry sly smug
  use f3_cat
  fill $ink
  mirror ellipse 22 29.5 3.3 3.2
  stroke $ink 2.4
  mirror line 16.5 25.5 27.5 27.5
  nofill
  stroke $ink 2.2
  curve 26 46.5 32 46.5 38.5 43

emoji cat_kiss U+1F63D | kitty kiss smooch love
  use f3_cat
  use eyes_closed 0 4
  nofill
  stroke $ink 2
  curve 30.5 43.5 34.5 45 31.5 47 34.5 49 30.5 50.5
  use heart 17 -17 0.17

emoji cat_pout U+1F63E | kitty angry grumpy mad
  use f3_cat
  use eyes 0 4
  stroke $ink 2.8
  mirror line 15 22 27 26.5
  nofill
  stroke $ink 2.2
  arc 32 49 6 4 205 335

emoji cat_cry U+1F63F | kitty sad tear upset
  use f3_cat
  use eyes 0 3
  stroke $ink 2.4
  mirror line 15.5 24 26 21
  nofill
  stroke $ink 2.2
  arc 32 49 6 4 205 335
  fill lin #c9ebff $tear 0 32 0 46
  stroke $teard 1.2
  path M 21 33 Q 16.5 40 19 43.5 Q 22 46 24 42.5 Q 24.5 38 21 33 Z

emoji cat_weary U+1F640 | kitty shocked scream oh no
  use f3_cat
  use eyes_wide 0 2
  fill $mouth
  stroke $ink 1.6
  ellipse 32 49 4.5 5.5

// The other two monkeys. `nat_monkey` is in nature.fsa.
category nature

emoji hear_no_evil U+1F649 | monkey cover ears deaf ignore
  use nat_monkey
  use nat_eyes 0 -2
  fill #8a5228
  mirror circle 30 38 1.1
  nofill
  stroke $natk 2
  arc 32 42 7.5 5.5 25 155
  fill rad #c98a55 #9a5e30 10 30 16
  stroke #55300f 2
  mirror ellipse 9.5 31 8 12
  nofill
  stroke #55300f 1.5
  mirror line 5.5 25 10 27
  mirror line 4.5 31 9.5 31.5
  mirror line 5.5 37 10 36

emoji speak_no_evil U+1F64A | monkey cover mouth quiet secret oops
  use nat_monkey
  use nat_eyes 0 -2
  fill rad #c98a55 #9a5e30 26 42 18
  stroke #55300f 2
  mirror ellipse 24 45 12 8 12
  nofill
  stroke #55300f 1.5
  mirror line 17 39.5 18.5 45.5
  mirror line 23 38.5 24 45
  mirror line 29 39 29.5 45

// People making a gesture. Skin follows the sender's tone.
category people

part f3_shirt
  fill lin #86b8f4 #4a86d8 0 44 0 62
  stroke #2f5fa8 2
  path M 9 63 Q 9 45 32 45 Q 55 45 55 63 Z

part f3_head
  fill #6b4226
  circle 32 23.5 16.5
  fill $skin
  stroke $skinl 1.8
  circle 32 26 13.2
  fill #6b4226
  nostroke
  path M 18.6 24.5 Q 19.5 10.5 32 10.5 Q 44.5 10.5 45.4 24.5 Q 39 17.5 32 18.5 Q 25 17.5 18.6 24.5 Z
  fill $ink
  mirror ellipse 27 27 1.7 2.3

part f3_person
  use f3_shirt
  use f3_head

emoji no_good U+1F645 | no stop forbidden nope cross
  use f3_person
  nofill
  stroke $ink 2
  arc 32 35.5 4 2.6 205 335
  stroke $skinl 9.5
  line 14 59 46 41
  line 50 59 18 41
  stroke $skin 6.5
  line 14 59 46 41
  line 50 59 18 41

emoji ok_person U+1F646 | okay yes circle agree
  use f3_shirt
  nofill
  stroke $skinl 8.5
  mirror curve 16 52 6 34 13 13 29 5
  stroke $skin 5.5
  mirror curve 16 52 6 34 13 13 29 5
  use f3_head
  nofill
  stroke $ink 2
  arc 32 31 4.5 3.2 25 155

emoji bow U+1F647 | sorry thanks respect apologize bowing
  fill lin #86b8f4 #4a86d8 0 40 0 62
  stroke #2f5fa8 2
  path M 5 63 Q 5 44 32 44 Q 59 44 59 63 Z
  fill $skin
  stroke $skinl 1.8
  circle 32 30 16
  fill #6b4226
  nostroke
  path M 15.6 30 Q 14 10 32 10 Q 50 10 48.4 30 Q 46 20 32 26 Q 18 20 15.6 30 Z
  nofill
  stroke $ink 2.2
  mirror arc 25 36 3.4 2.6 25 155
  arc 32 41 4 2.4 25 155
  fill $skin
  stroke $skinl 1.8
  path M 20 50 Q 32 44 44 50 L 42 58 Q 32 54 22 58 Z
  nofill
  stroke $skinl 1.2
  line 32 48 32 56
  stroke #9ab8e8 2.4
  mirror line 9 26 5 20
  mirror line 13 19 10.6 12.6

emoji raising_hand U+1F64B | me question volunteer hello pick
  use f3_shirt
  nofill
  stroke $skinl 9
  line 47 54 54 34 53 17
  stroke $skin 6
  line 47 54 54 34 53 17
  fill $skin
  stroke $skinl 1.8
  ellipse 53 11.5 5.5 7
  use f3_head
  fill $mouth
  nostroke
  path M 27.5 32 Q 32 34 36.5 32 Q 36 37 32 37 Q 28 37 27.5 32 Z

emoji person_frowning U+1F64D | sad upset unhappy down
  use f3_person
  stroke $ink 1.8
  mirror line 23.5 23.5 29.5 21.5
  nofill
  stroke $ink 2
  arc 32 36 4.5 3.2 205 335

emoji person_pouting U+1F64E | angry mad grumpy annoyed
  use f3_person
  stroke $ink 2.2
  mirror line 23 20.5 30 23.5
  fill #e0605a66
  nostroke
  mirror ellipse 23.5 32 3 2
  stroke $ink 2
  line 28.5 34.5 35.5 34.5
