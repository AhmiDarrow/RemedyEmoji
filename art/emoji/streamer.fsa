// Streaming and content-creation emotes. Original FreeSpeak art.
category streamer

color st_btnd #1c4fb0
color st_scr #26304a
color st_scrl #5a6788
color st_bez #3a4152
color st_bezl #7d879c
color st_purp #9a5cf5
color st_purpd #5a2aa8
color st_grn #3ecf6e
color st_grnd #1c8a40
color st_gold #ffc93c
color st_goldd #c98a0a

// ---- shared pieces ----

part st_btn
  fill lin #7dbdff #2f76e8 0 6 0 58
  stroke $st_btnd 2.2
  rect 6 6 52 52 12
  fill #ffffff33
  nostroke
  path M 12 20 Q 12 11 21 11 L 43 11 Q 52 11 52 20 Q 32 14 12 20 Z

part st_mic
  nofill
  stroke $steeld 3
  arc 32 27 16.5 17 0 180
  line 32 44 32 55
  stroke $steeld 4.4
  line 20 57 44 57
  fill lin #f4f7fa #9aa7b6 20 0 46 0
  stroke $steeld 2.2
  rect 21.5 4 21 34 10.5
  stroke $steeld 1.5
  line 22.5 15 41.5 15
  line 22.5 21 41.5 21
  line 22.5 27 41.5 27
  fill #ffffff88
  nostroke
  ellipse 27 10.5 2 3.6

part st_spk
  fill lin #eef2f6 #8f9cab 0 12 0 52
  stroke $steeld 2.2
  path M 5 24 L 15 24 L 30 10 Q 33 9 33 13 L 33 51 Q 33 55 30 54 L 15 40 L 5 40 Q 3 40 3 38 L 3 26 Q 3 24 5 24 Z
  stroke $steeld 1.5
  line 15 24.5 15 39.5

part st_mega
  fill lin #9aa7b6 #5d6670 0 40 0 56
  stroke #454d57 2
  rect 17 38 9 17 3.5
  fill lin #ff8a7a #e23a34 0 8 0 56
  stroke $redd 2.2
  path M 11 24 L 25 24 L 50 8 L 50 56 L 25 40 L 11 40 Z
  fill lin #eef2f6 #9aa7b6 0 24 0 40
  stroke $steeld 2
  rect 4 24 9 16 3
  fill lin #ffffff #d5dae2 0 8 0 56
  stroke #8b94a2 2
  ellipse 50.5 32 5 25
  fill #ffffff55
  nostroke
  poly 15 26.5 25 26.5 44 14.5 44 19 25 30 15 30

part st_mon
  fill lin #aab3c2 #6d7789 0 46 0 58
  stroke #4b5364 1.8
  poly 26 45 38 45 40 54 24 54
  rect 17 53 30 5.5 2.7
  fill lin #565f75 #333a4b 0 6 0 46
  stroke $st_bezl 2.2
  rect 3.5 6 57 41 5
  fill lin #33426a #1d2438 0 10 0 43
  nostroke
  rect 7.5 10 49 33 2

part st_bell
  fill $st_goldd
  nostroke
  circle 32 54 5.5
  fill rad #fff08a #ffb21c 24 18 40
  stroke #c98a0a 2.2
  path M 32 8 C 17 8 15 22 15 32 C 15 41 11 44 8 47 Q 6 51 10 51 L 54 51 Q 58 51 56 47 C 53 44 49 41 49 32 C 49 22 47 8 32 8 Z
  fill #ffd23d
  stroke #c98a0a 2
  circle 32 7.5 3.4
  fill #ffffff77
  nostroke
  ellipse 23.5 22 2.6 7 14

part st_tick
  stroke #ffffff 6
  line 19 33 28 42 45 22

part st_film
  fill lin #4a5266 #2b3140 0 4 0 60
  stroke #7d879c 2
  rect 12 3 40 58 3
  fill #dfe6f0
  nostroke
  mirror rect 15 7 4.6 5 1.2
  mirror rect 15 17.5 4.6 5 1.2
  mirror rect 15 28 4.6 5 1.2
  mirror rect 15 38.5 4.6 5 1.2
  mirror rect 15 49 4.6 5 1.2
  fill lin #bfe6ff #62aef2 0 6 0 58
  rect 22.5 7 19 22 2
  rect 22.5 33 19 24 2

part st_cam
  fill lin #7d8aa3 #4a546b 0 20 0 52
  stroke #2f3748 2.2
  poly 40 30 58 20 58 50 40 40
  rect 5 17 38 34 6
  fill rad #bfe6ff #3d8bff 20 30 12
