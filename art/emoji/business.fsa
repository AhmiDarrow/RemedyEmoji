// Work and business emotes: office objects, money, mail and office-speak badges. Original FreeSpeak art.
category business

color bzline #8b96a8
color bzgrey #8d99ab
color bzgreen #3fbf5f
color bzgreend #1f7a34
color bzblue #3f8ef0
color bzblued #1f4fa0
color bzgold #ffc93a
color bzgoldd #c98408
color bzwood #8a5226
color bzwoodd #5e3410
color bznavy #2a3550

part bz_page
  fill lin #ffffff #dde3ec 0 4 0 60
  stroke $bzline 2.2
  path M 12 5 L 40 5 L 52 17 L 52 59 L 12 59 Z
  fill #c3ccd9
  stroke $bzline 1.6
  poly 40 5 40 17 52 17

part bz_cal
  fill lin #ffffff #dde3ec 0 10 0 60
  stroke $bzline 2.2
  rect 6 9 52 50 6
  fill lin #ff6b5e #e23a36 0 9 0 24
  stroke $redd 2.2
  path M 6 24 L 6 15 Q 6 9 12 9 L 52 9 Q 58 9 58 15 L 58 24 Z
