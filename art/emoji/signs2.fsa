// Street signs, facility signs and things around a building. Original Remedy Emoji art.
category symbols

color s2k #2a2f3b

part s2_ban_bg
  fill #ffffff
  circle 32 32 25

part s2_ban
  nofill
  stroke $redd 8.5
  circle 32 32 24
  line 15 15 49 49
  stroke $red 5
  circle 32 32 24
  line 15 15 49 49

part s2_man_w
  fill $white
  circle 32 12.5 5.5
  path M 23 21 Q 23 19.5 25 19.5 L 39 19.5 Q 41 19.5 41 21 L 41 38 L 37.5 38 L 37.5 57 L 33 57 L 33 40 L 31 40 L 31 57 L 26.5 57 L 26.5 38 L 23 38 Z

part s2_woman_w
  fill $white
  circle 32 12.5 5.5
  path M 27 19.5 L 37 19.5 L 44 43 L 37.5 43 L 37.5 57 L 33 57 L 33 43 L 31 43 L 31 57 L 26.5 57 L 26.5 43 L 20 43 Z

