// Animals, weather and plants. Original FreeSpeak art.
category nature

color natk #2a1c14
color natg #2f7a1c

part nat_eyes
  fill $natk
  mirror ellipse 22 29 3.4 4.2
  fill $white
  mirror circle 20.9 27.4 1.2

part nat_nose
  fill $natk
  ellipse 32 38.5 4.6 3.3

part nat_mouth
