// Hearts, signs, marks and badges. Original FreeSpeak art.
category symbols

color sym_gold #e0860a
color sym_blue #2f8df0
color sym_blued #1c5fc0
color sym_green #35b84c
color sym_greend #1c8232
color sym_grey #7f8a9e

part sym_shine
  fill #ffffff66
  ellipse 19.5 21.5 5.6 3.4 -40

part sym_spark
  fill rad #fffbd0 #ffc61c 28 26 30
  stroke $sym_gold 2.6
  path M 32 3 Q 35.5 28.5 61 32 Q 35.5 35.5 32 61 Q 28.5 35.5 3 32 Q 28.5 28.5 32 3 Z

part sym_pink_heart
  fill rad #ffb3d6 #ff5fa2 24 22 40
  stroke #c92f78 2.4
  path M 32 55 C 6 38 5 22 13 14.5 C 20.5 8 29 11.5 32 19 C 35 11.5 43.5 8 51 14.5 C 59 22 58 38 32 55 Z
  use sym_shine

part sym_blue_tile
  fill lin #74c2ff #2f86ea 0 5 0 59
  stroke $sym_blued 2.4
  rect 5 5 54 54 12

part sym_arrow
  fill $white
  stroke $white 2
  poly 32 13 49 31 38.5 31 38.5 50 25.5 50 25.5 31 15 31

part sym_cycle_arrow
  stroke $sym_greend 10.4
  line 23.5 21.5 30 10.5 34 10.5 38.5 18.5
  fill $sym_green
  stroke $sym_greend 2
  poly 44.5 28.5 47 14.5 32 23
  stroke #4fd165 6.4
  line 23.5 21.5 30 10.5 34 10.5 38.5 18.5
  fill #4fd165
  nostroke
  poly 43 25.5 44.5 17.5 35.5 22.5

