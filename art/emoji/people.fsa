  line 59 9 55 13
  line 32 3 32 8

emoji raised_hand U+270B | stop high five palm halt
  use pp_hand 3 0

emoji pray U+1F64F | please thanks hope namaste
  fill lin $pp_blue $pp_blued 0 46 0 63
  stroke $pp_blued 2
  mirror poly 12 46 31 56 31 62 5 62 5 54
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  mirror path M 32 4 Q 25 5 23.5 18 L 21 37 Q 15 43 14 49 L 29 58 L 32 54 Z
  nofill
  stroke $skinl 1.6
  mirror curve 23 31 27 34 29 42

emoji muscle U+1F4AA | strong flex biceps gym power
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  blob 11 14 17 6 27 7 31 15 27 24 31 30 41 24 53 28 59 40 56 52 44 58 26 58 12 52 8 40 10 26
  nofill
  stroke $skinl 1.8
  curve 28 29 31 34 31 40
  curve 11 19 20 22 29 19
  stroke $skind 1.6
  curve 38 34 45 30 52 35

emoji point_up U+261D | one above this up
  use pp_point

emoji point_right U+1F449 | this that next direction
  use pp_point 0 0 1 90

emoji point_left U+1F448 | this that back direction
  use pp_point 0 0 1 -90

emoji point_down U+1F447 | this below down direction
  use pp_point 0 0 1 180

emoji handshake U+1F91D | deal agree partner welcome
  fill lin $pp_blue $pp_blued 0 16 0 48
