// Hands, body parts and people gestures. Original FreeSpeak art.
category people

color pp_blue #4a9ff5
color pp_blued #2a6fc4
color pp_spark #ffb21c

// Open hand, palm forward, fingers up.
part pp_hand
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  rect 16 11 9.5 32 4.7
  rect 25.5 5 9.5 36 4.7
  rect 35 8 9.5 34 4.7
  rect 44.5 16 8.5 28 4.2
  path M 16 35 L 53 35 L 53 45 Q 52 59 36 59 Q 24 59 18 52 Q 9 46 5.5 35 Q 4 29 8 28 Q 12 27.5 13.5 32 Q 14.5 36 16 38 Z
  nostroke
  rect 17.1 31 34.8 7
  nofill
  stroke $skind 1.5
  curve 20 41 25 46 24 53

// Flat hand, fingers together.
part pp_mitt
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  path M 22 40 Q 12 32 9 22 Q 8 17 12 16.5 Q 16 16 17 21 Q 18 26 22 28 Z
  rect 20 5 25 53 11
  nostroke
  rect 21.1 27 5 14
  nofill
  stroke $skinl 1.5
  line 26.5 7.5 26.5 26
  line 32.5 6 32.5 27
  line 38.5 7.5 38.5 26

// Fist with the index finger pointing up.
part pp_point
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  rect 15 4 10.5 38 5.2
  path M 15 32 L 42 32 Q 52 32 52 42 L 52 49 Q 52 59 42 59 L 25 59 Q 15 59 15 49 Z
  nostroke
  rect 16.1 30 8.3 4
  stroke $skinl 2.2
  rect 25.5 26 9 15 4.5
  rect 34.5 27 9 15 4.5
  rect 43.5 29 8.5 14 4.2
  path M 13 47 Q 13 41 20 41 L 32 42.5 Q 37 43.5 36.5 47.5 Q 36 51.5 31 51.5 L 20 52.5 Q 13 53 13 47 Z

part pp_foot
  fill lin #c79a6b #a3723f 0 8 0 58
  stroke #6f4a26 1.8
  blob 25 22 33 19 40 26 39 40 37 52 32 58 27 54 27 42 23 32
  circle 22.5 13 4.2
  circle 30.5 9.5 3.5
  circle 37 11.5 3.1
  circle 42 16 2.7

emoji thumbsup U+1F44D | like yes good approve +1
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  path M 9 38 Q 9 30 17 28 Q 22 20 22 10 Q 23 4 28.5 4.5 Q 34 5 33.5 12 L 32 27 L 46 27 L 46 58 L 17 58 Q 9 58 9 50 Z
  rect 30 26 25.5 9 4.5
  rect 31 34.5 25.5 8.5 4.2
  rect 30 42.5 24.5 8.5 4.2
  rect 29 50.5 22.5 8 4

emoji thumbsdown U+1F44E | dislike no bad disapprove -1
  use thumbsup 0 0 1 180 flip

emoji wave U+1F44B | hello hi bye greeting
  use pp_hand 3 3 0.86 18
  nofill
  stroke $pp_blue 2.6
  curve 4 26 6 16 13 9
  curve 51 55 58 48 60 38

emoji clap U+1F44F | applause bravo congrats praise
  use pp_mitt -8 5 0.82 -22
  use pp_mitt 9 5 0.82 20 flip
  stroke $pp_spark 2.8
  line 31 3 31 10
  line 19 4 22 10
  line 43 4 40 10

emoji ok_hand U+1F44C | okay perfect fine good
  fill rad $skin $skind 22 16 80
  stroke $skinl 2.2
  rect 29 5 9.5 36 4.7
  path M 39.5 38 L 43 11 Q 44 6 48.5 7 Q 53 8 52.5 13 L 49 40 Z
  path M 48 42 L 53.5 22 Q 55 17.5 58.5 18.5 Q 62 20 61 24.5 L 56 46 Z
  blob 29 38 50 36 56 46 48 58 34 59 27 50
  nofill
  stroke $skinl 10
  circle 20 40 10.5
  stroke $skin 5.6
  circle 20 40 10.5

