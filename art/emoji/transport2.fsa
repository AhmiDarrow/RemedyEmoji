// Vehicles on road, rail, water and in the air. Original Remedy Emoji art.
category travel

color t2glass #bfe6ff
color t2glassd #4f6a8a
color t2tyre #2f343e

part t2_wheel
  fill $t2tyre
  stroke #16181d 2
  circle 32 32 6.6
  fill #b9c4cf
  nostroke
  circle 32 32 2.6

part t2_carkit
  fill $t2glass
  stroke $t2glassd 1.4
  path M 19 28 L 24 20.5 L 31 20.5 L 31 28 Z
  path M 34 20.5 L 40 20.5 L 45.5 28 L 34 28 Z
  fill #fff6a0
  nostroke
  rect 56 33 4 4 1.5
  fill #e2584a
  rect 4 33 3 4 1.5
  use t2_wheel -16 14
  use t2_wheel 14 14

part t2_frontkit
  fill $t2glass
  stroke $t2glassd 1.4
  path M 15 28 L 18 17 L 46 17 L 49 28 Z
  fill #fff6a0
  stroke #b8a01c 1.2
  mirror circle 15 38 3.6
  fill #3a3f4c
  nostroke
  rect 23 35 18 6 2
  fill $t2tyre
  mirror rect 9 49 9 8 2

part t2_buskit
  fill $t2glass
  stroke $t2glassd 1.4
  rect 7 19 9 11 2
  rect 19 19 9 11 2
  rect 31 19 9 11 2
  rect 43 19 9 11 2
  fill #fff6a0
  nostroke
  rect 57 37 4 4 1.5
  use t2_wheel -17 16
  use t2_wheel 15 16

part t2_railkit
  fill $t2glass
  stroke $t2glassd 1.4
  rect 8 22 10 10 2
  rect 21 22 10 10 2
  rect 34 22 10 10 2
  rect 47 22 10 10 2
  fill $t2tyre
  nostroke
  circle 14 50 4
  circle 26 50 4
  circle 40 50 4
  circle 52 50 4
  rect 2 54 60 2.4 1

part t2_trainfront
  fill $t2glass
  stroke $t2glassd 1.4
  rect 16 16 32 14 4
  fill #fff6a0
  stroke #b8a01c 1.2
  mirror circle 18 40 3.4
  fill $t2tyre
  nostroke
  rect 14 51 36 4 2
  nofill
  stroke #5d6670 2.4
  line 20 56 12 62
  line 44 56 52 62

part t2_sea
  fill lin #6fd0ff #1f74d8 0 50 0 62
  stroke #134c9c 1.8
  path M 2 62 L 2 54 Q 10 48 18 54 Q 26 48 34 54 Q 42 48 50 54 Q 56 50 62 54 L 62 62 Z

part t2_plane
  fill lin #ffffff #c9d6e6 0 0 0 64
  stroke #5d6a7c 2
  path M 32 3 Q 37 6 37 16 L 37 24 L 60 38 L 60 44 L 37 38 L 36 52 L 44 58 L 44 62 L 32 59 L 20 62 L 20 58 L 28 52 L 27 38 L 4 44 L 4 38 L 27 24 L 27 16 Q 27 6 32 3 Z
  fill $t2glass
  stroke $t2glassd 1.2
  path M 29 12 Q 32 8 35 12 L 35 15 L 29 15 Z

