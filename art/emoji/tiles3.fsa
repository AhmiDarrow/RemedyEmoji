// The Japanese word buttons. The characters are drawn as plain strokes.
// Original Remedy Emoji art.
category symbols

part t3_green_tile
  fill lin #7fd47a #2f9a3c 0 5 0 59
  stroke #145a24 2.4
  rect 5 5 54 54 12

part t3_orange_disc
  fill rad #ffb04a #e8701c 24 22 40
  stroke #a8420a 2.4
  circle 32 32 27

emoji koko U+1F201 | japanese here button katakana
  use sym_blue_tile
  nofill
  stroke $white 3.6
  line 13 22 28 22 28 42 13 42
  line 36 22 51 22 51 42 36 42

