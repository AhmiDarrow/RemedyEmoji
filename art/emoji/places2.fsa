// Landscapes and buildings. Original Remedy Emoji art.
category travel

color p2win #bfe6ff
color p2wind #4f6a8a

part p2_sky
  fill lin #9fdcff #dff4ff 0 8 0 50
  stroke #5a9ad0 2.2
  rect 4 8 56 48 8

part p2_door
  fill #6e4526
  stroke #45280f 1.4
  path M 27 58 L 27 46 Q 32 41 37 46 L 37 58 Z

part p2_windows
