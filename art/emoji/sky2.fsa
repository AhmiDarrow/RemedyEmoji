// Sky, weather, the moon's phases and the little landscapes. Original Remedy Emoji art.
category nature

color skdk #1b2440
color skwin #ffe27a

part sk_night
  fill lin #27346b #101633 0 9 0 55
  stroke #0a0e22 2.2
  rect 5 9 54 46 8

part sk_dusk
  fill lin #5a4aa8 #ff9a5c 0 9 0 55
  stroke #3a2a78 2.2
  rect 5 9 54 46 8

part sk_dawn
  fill lin #ffd27a #ff8a5c 0 9 0 55
  stroke #c2562c 2.2
  rect 5 9 54 46 8

part sk_stars
  fill #fff6c8
  circle 14 18 1.3
  circle 25 14.5 1
  circle 38 19 1.3
  circle 50 15 1
  circle 45 26 0.9
  circle 19 27 0.9

part sk_moon_dark
  fill rad #7b8498 #3d4456 22 20 46
  stroke #262b38 2.2
  circle 32 32 27.6
  fill #2f3545
  nostroke
  circle 23 22 4
  circle 40 40 5.5
  circle 21 42 2.6

part sk_moon_full
  fill rad #fff6b0 #ffc93a 22 20 46
  stroke #d99a0c 2.2
  circle 32 32 27.6
  fill #f0b52e
  nostroke
  circle 23 22 4
  circle 40 40 5.5
  circle 21 42 2.6

part sk_lit_cres
  fill rad #fff6b0 #ffc93a 44 22 40
  path M 32 4.4 C 47.2 4.4 59.6 16.8 59.6 32 C 59.6 47.2 47.2 59.6 32 59.6 C 46 50 46 14 32 4.4 Z

part sk_lit_half
  fill rad #fff6b0 #ffc93a 44 22 40
  path M 32 4.4 C 47.2 4.4 59.6 16.8 59.6 32 C 59.6 47.2 47.2 59.6 32 59.6 Z
  fill #f0b52e
  circle 44 40 5

part sk_lit_gib
  fill rad #fff6b0 #ffc93a 40 22 44
  path M 32 4.4 C 47.2 4.4 59.6 16.8 59.6 32 C 59.6 47.2 47.2 59.6 32 59.6 C 14 50 14 14 32 4.4 Z
  fill #f0b52e
  circle 40 40 5.5

part sk_rim
  nofill
  stroke #262b38 2.2
  circle 32 32 27.6

part sk_moon_face
  fill rad #fff3a0 #ffc93a 18 22 40
  stroke #d99a0c 2.2
  path M 40 4 C 16 2 3 20 5 37 C 8 55 28 63 48 56 C 31 53 22 41 23 28 C 24 17 30 9 40 4 Z
  fill $ink
  nostroke
  ellipse 16 27 2 2.8
  nofill
  stroke $ink 2
  arc 14 37 4.5 3.5 20 130

part sk_sun
  use nat_ray
  use nat_ray 0 0 1 45
  use nat_ray 0 0 1 90
  use nat_ray 0 0 1 135
  use nat_ray 0 0 1 180
  use nat_ray 0 0 1 225
  use nat_ray 0 0 1 270
  use nat_ray 0 0 1 315
  fill rad #fff08a #ffb21c 26 26 26
  stroke #e0860a 2.2
  circle 32 32 17.5

part sk_drops
  fill $tear
  stroke $teard 1
  path M 20 47 Q 16.5 53 20 55.5 Q 23.5 53 20 47 Z
  path M 32 49 Q 28.5 55 32 57.5 Q 35.5 55 32 49 Z
  path M 44 47 Q 40.5 53 44 55.5 Q 47.5 53 44 47 Z

