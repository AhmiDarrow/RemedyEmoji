// People, what they wear, and tokens of love. Original Remedy Emoji art.
category people

color p3brown #6b4226
color p3black #2a2018
color p3blond #f2c23a
color p3grey #c4ccd6

part p3_face
  fill $skin
  stroke $skinl 2
  mirror circle 12.5 36 4
  circle 32 35 20
  fill $ink
  nostroke
  mirror ellipse 24.5 34 2.2 3
  nofill
  stroke $ink 2.2
  arc 32 40 7 5 25 155

part p3_short_hair
  fill $p3brown
  path M 11.5 32 Q 10 12 32 12 Q 54 12 52.5 32 Q 46 21 32 23 Q 18 21 11.5 32 Z

part p3_small
  fill $skin
  stroke $skinl 1.4
  circle 32 16 8
  fill $ink
  nostroke
  mirror circle 29 16 1.1
  nofill
  stroke $ink 1.4
  arc 32 18.5 3 2.2 25 155

